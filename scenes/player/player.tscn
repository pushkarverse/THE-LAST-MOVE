; ── Collision shape  ─────────────────────────────────────────────────
; Player world-space collision: ~12 px wide, ~28 px tall capsule
; AnimatedSprite2D is at scale 0.25 so 128*0.25=32 px visual (slight overhang = fine)
[sub_resource type="CapsuleShape2D" id="CAP_1"]
radius = 6.0
height = 28.0

; ─────────────────────────────────────────────────────────────────────
;  Scene nodes
; ─────────────────────────────────────────────────────────────────────

; CharacterBody2D root – scale stays at 1,1; only the sprite child is scaled.
; collision_layer 2  = player layer
; collision_mask  1  = terrain layer
; collision_mask  8  = hazard layer (for Area2D hazards to detect player)
[node name="Player" type="CharacterBody2D"]
collision_layer = 2
collision_mask = 1
script = ExtResource("1_script")

; Sprite child at 0.25 scale → 32 px visual height at native resolution
[node name="AnimatedSprite2D" type="AnimatedSprite2D" parent="."]
position = Vector2(0, -2)
scale = Vector2(0.25, 0.25)
sprite_frames = SubResource("SF_1")
animation = &"idle"

; Collision shape centered on the CharacterBody2D origin
[node name="CollisionShape2D" type="CollisionShape2D" parent="."]
position = Vector2(0, -14)
shape = SubResource("CAP_1")
